# API
PORT=4000
HOST=127.0.0.1

# Where the SQLite database + encryption key + config backups live.
# Defaults to <repo>/.data
# MCPDECK_DATA_DIR=/absolute/path

# Optional bearer token for REST webhook routes (/api/hooks/*)
# MCPDECK_TOKEN=

# Origin used for same-host CORS fallbacks (the web app defaults to :3100)
# MCPDECK_WEB_ORIGIN=http://localhost:3100

# Web -> API base URL (baked in at build time for the browser)
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
