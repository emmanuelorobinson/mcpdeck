{
  "name": "mcpdeck",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/api start",
    "typecheck": "bunx tsc -p apps/api --noEmit && bunx tsc -p apps/web --noEmit",
    "smoke": "./scripts/smoke.sh",
    "shot": "bun scripts/shot.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0"
  }
}
